[Unit]
Description=Copy-Trade Aggregator — consensus radar for proven traders
After=network-online.target
Wants=network-online.target
# StartLimit* belong in [Unit]. They used to sit in [Service], where systemd
# ignored them with a warning -- so the crash-loop guard this file exists to
# provide was never actually armed, and a failing service would have retried
# forever against the venues instead of stopping after five attempts.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
EnvironmentFile=__REPO_DIR__/.env
ExecStart=__PYTHON__ -m cta.cli run --interval __INTERVAL__
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
