# ─────────────────────────────────────────────────────────────────────────────
# Local configuration for `python -m cta.cli ...`
# Copy to .env and fill in. Never commit .env (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram (required for notifications) ───────────────────────────────────
# 1. Message @BotFather -> /newbot -> copy the token
# 2. Message your bot once, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: require this header on the /telegram webhook (recommended)
TELEGRAM_WEBHOOK_SECRET=
# Optional: required for /kick, /refresh, /boot, /track
OWNER_TOKEN=

# ── Venues (all free, no keys) ──────────────────────────────────────────────
HL_BASE_URL=https://api.hyperliquid.xyz
HL_STATS_URL=https://stats-data.hyperliquid.xyz/Mainnet/leaderboard
DYDX_BASE_URL=https://indexer.dydx.trade/v4
# NOT arbitrum.gmxapi.io — that host does not exist and the old default made
# every GMX call fail silently while the venue reported itself healthy.
GMX_BASE_URL=https://arbitrum-api.gmxinfra.io
# OKX copy trading: the only free venue with a *ranked* lead-trader board AND a
# closed-position history per trader. Keyless. This is what makes discovery
# possible without downloading a 39 MB leaderboard.
OKX_BASE_URL=https://www.okx.com
OKX_SORT_TYPE=pnl_ratio
OKX_MIN_LEAD_DAYS=3
OKX_MAX_PAGES=8
OKX_MAX_TRADERS=300
ENABLED_SOURCES=hyperliquid,okx,dydx,gmx

# ── Resting orders (the only way to enter at the traders' own price) ────────
# Hyperliquid charges frontendOpenOrders ~20 weight vs 2 for a position poll, so
# the sweep is bounded and rotates. Zero means "never read orders".
ORDERS_ENABLED=true
ORDERS_MAX_WALLETS=40
ORDERS_MAX_AGE_MIN=1440

# dYdX and GMX expose no follower leaderboard, so seed them with known wallets.
# A single proven trader on a second venue is worth more than ten on Hyperliquid.
DYDX_SEED_WALLETS=
GMX_SEED_WALLETS=

# ── Radar sizing ────────────────────────────────────────────────────────────
WATCHLIST_MAX=150
DISCOVERY_MAX_CANDIDATES=300
WATCHLIST_MIN_GRADE=PROVEN

# ── Convergence gates (the heart of the system) ─────────────────────────────
MIN_INDEPENDENT_TRADERS=2
MIN_ELITE_OR_PROVEN=2
CONVERGENCE_WINDOW_MIN=90
ENTRY_TOLERANCE_BPS=50
MAX_SLIPPAGE_BPS=50
MAX_MEDIAN_LEVERAGE=10

# ── Emission ────────────────────────────────────────────────────────────────
MIN_SIGNAL_SCORE=65
RISK_PER_TRADE_PCT=1.0

# ── AI assistant (Workers AI only; empty locally = deterministic fallback) ──
AI_ENABLED=true
AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_DAILY_NEURON_SOFT_CAP=8000

# ── Runtime ─────────────────────────────────────────────────────────────────
DRY_RUN=false
LOG_LEVEL=INFO
# On a server (AWS/VPS) there is no 50-subrequest ceiling, so the whole
# watchlist can be swept every tick instead of a rotating window.
POLL_INTERVAL_SEC=45
